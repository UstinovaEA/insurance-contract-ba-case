<bpmn:sequenceFlow id="f8" sourceRef="T5" targetRef="T6"/>
<bpmn:sequenceFlow id="f9" sourceRef="T6" targetRef="T3"/>
<bpmn:sequenceFlow id="f10" name="Да" sourceRef="G1" targetRef="T7"/>
<bpmn:sequenceFlow id="f11" sourceRef="T7" targetRef="T8"/>
<bpmn:sequenceFlow id="f12" sourceRef="T8" targetRef="T9"/>
<bpmn:sequenceFlow id="f13" sourceRef="T9" targetRef="E1"/>
<bpmn:sequenceFlow id="f14" sourceRef="S3" targetRef="T12"/>
<bpmn:sequenceFlow id="f15" sourceRef="T12" targetRef="T13"/>
<bpmn:sequenceFlow id="f16" sourceRef="T13" targetRef="E2"/>
