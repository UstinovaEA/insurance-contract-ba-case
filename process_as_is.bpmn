<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
<bpmn:collaboration id="Collab_1"><bpmn:participant id="Pool_1" name="Оформление договора страхования юр. лица (AS IS)" processRef="Process_1"/></bpmn:collaboration>
<bpmn:process id="Process_1" isExecutable="false"><bpmn:laneSet id="LaneSet_1">
<bpmn:lane id="lane_client" name="Клиент (юр. лицо)"><bpmn:flowNodeRef>S1</bpmn:flowNodeRef><bpmn:flowNodeRef>T2</bpmn:flowNodeRef><bpmn:flowNodeRef>T6</bpmn:flowNodeRef><bpmn:flowNodeRef>S3</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="lane_mgr" name="Менеджер по страхованию"><bpmn:flowNodeRef>S2</bpmn:flowNodeRef><bpmn:flowNodeRef>T1</bpmn:flowNodeRef><bpmn:flowNodeRef>T3</bpmn:flowNodeRef><bpmn:flowNodeRef>T5</bpmn:flowNodeRef><bpmn:flowNodeRef>T7</bpmn:flowNodeRef><bpmn:flowNodeRef>T9</bpmn:flowNodeRef><bpmn:flowNodeRef>E1</bpmn:flowNodeRef><bpmn:flowNodeRef>T12</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="lane_uw" name="Андеррайтер"><bpmn:flowNodeRef>T4</bpmn:flowNodeRef><bpmn:flowNodeRef>G1</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="lane_hq" name="Головная компания"><bpmn:flowNodeRef>T8</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="lane_claims" name="Отдел урегулирования убытков"><bpmn:flowNodeRef>T13</bpmn:flowNodeRef><bpmn:flowNodeRef>E2</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="S1" name="Обращение клиента"><bpmn:outgoing>f1</bpmn:outgoing></bpmn:startEvent>
<bpmn:startEvent id="S2" name="Менеджер находит клиента сам"><bpmn:outgoing>f2</bpmn:outgoing></bpmn:startEvent>
<bpmn:task id="T1" name="Выяснить, что страхуем, и запросить данные"><bpmn:incoming>f1</bpmn:incoming><bpmn:incoming>f2</bpmn:incoming><bpmn:outgoing>f3</bpmn:outgoing></bpmn:task>
<bpmn:task id="T2" name="Передать данные по объекту страхования"><bpmn:incoming>f3</bpmn:incoming><bpmn:outgoing>f4</bpmn:outgoing></bpmn:task>
<bpmn:task id="T3" name="Выбрать шаблон по правилам страхования и заполнить договор"><bpmn:incoming>f4</bpmn:incoming><bpmn:incoming>f9</bpmn:incoming><bpmn:outgoing>f5</bpmn:outgoing></bpmn:task>
<bpmn:task id="T4" name="Проверить договор, рассчитать тариф и премию"><bpmn:incoming>f5</bpmn:incoming><bpmn:outgoing>f6</bpmn:outgoing></bpmn:task>
<bpmn:exclusiveGateway id="G1" name="Договор согласован?"><bpmn:incoming>f6</bpmn:incoming><bpmn:outgoing>f7</bpmn:outgoing><bpmn:outgoing>f10</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:task id="T5" name="Запросить уточнения у клиента"><bpmn:incoming>f7</bpmn:incoming><bpmn:outgoing>f8</bpmn:outgoing></bpmn:task>
<bpmn:task id="T6" name="Дать уточнения (хранение, склад, объём, охрана)"><bpmn:incoming>f8</bpmn:incoming><bpmn:outgoing>f9</bpmn:outgoing></bpmn:task>
<bpmn:task id="T7" name="Подписать договор с клиентом"><bpmn:incoming>f10</bpmn:incoming><bpmn:outgoing>f11</bpmn:outgoing></bpmn:task>
<bpmn:task id="T8" name="Принять договор, внести в CRM"><bpmn:incoming>f11</bpmn:incoming><bpmn:outgoing>f12</bpmn:outgoing></bpmn:task>
<bpmn:task id="T9" name="Отслеживать срок оплаты в CRM"><bpmn:incoming>f12</bpmn:incoming><bpmn:outgoing>f13</bpmn:outgoing></bpmn:task>
<bpmn:endEvent id="E1" name="Договор действует"><bpmn:incoming>f13</bpmn:incoming></bpmn:endEvent>
<bpmn:startEvent id="S3" name="Страховой случай"><bpmn:outgoing>f14</bpmn:outgoing></bpmn:startEvent>
<bpmn:task id="T12" name="Принять документы от страхователя"><bpmn:incoming>f14</bpmn:incoming><bpmn:outgoing>f15</bpmn:outgoing></bpmn:task>
<bpmn:task id="T13" name="Начать урегулирование убытка"><bpmn:incoming>f15</bpmn:incoming><bpmn:outgoing>f16</bpmn:outgoing></bpmn:task>
<bpmn:endEvent id="E2" name="Передано в урегулирование"><bpmn:incoming>f16</bpmn:incoming></bpmn:endEvent>
